# Database
DATABASE_URL=postgres://velvetscoop:velvetscoop@localhost:5433/velvetscoop

# Cache / queues
REDIS_URL=redis://localhost:6380

# Server
PORT=3000
NODE_ENV=development
DOMAIN=localhost

# Secrets (generate with `openssl rand -base64 48`)
SESSION_SECRET=changeme
COOKIE_SECRET=changeme
CSRF_SECRET=changeme

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Authentik OIDC (required at boot; values can be placeholders until Authentik app exists,
# OIDC discovery is lazy and only /api/auth/* fails until configured correctly).
AUTHENTIK_ISSUER_URL=https://auth.example.invalid/application/o/velvet-scoop/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3000/api/auth/callback
AUTHENTIK_MEMBER_GROUP=velvet-scoop-members
AUTHENTIK_ADMIN_GROUP=velvet-scoop-admins
